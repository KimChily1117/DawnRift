<!-- 로그인 화면. -->
<UserControl x:Class="Launcher.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Width="420" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{StaticResource Panel}"
            BorderBrush="{StaticResource Gold}" BorderThickness="2" Padding="32">
        <StackPanel>
            <TextBlock Style="{StaticResource Title}" Text="LEAGUE PORTFOLIO" HorizontalAlignment="Center" />
            <TextBlock Text="비상업 포트폴리오 · Riot Games 에셋 사용" Foreground="{StaticResource Muted}"
                       HorizontalAlignment="Center" Margin="0,4,0,24" FontSize="12" />
            <TextBlock Text="소환사 이름" Foreground="{StaticResource Gold}" Margin="0,0,0,6" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="16" />
            <TextBlock Text="서버" Foreground="{StaticResource Gold}" Margin="0,16,0,6" />
            <TextBox Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="로그인" Margin="0,24,0,0" Height="44" Command="{Binding LoginCommand}" IsDefault="True" />
            <TextBlock Text="{Binding Message}" Foreground="{StaticResource Red}" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
