<!-- 방 목록 화면. -->
<UserControl x:Class="Launcher.Views.RoomListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource Title}" Text="사용자 설정 게임 · 방 목록" />
            <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Margin="0,16,0,16" Background="{StaticResource Panel}" BorderBrush="{StaticResource GoldDark}" BorderThickness="1" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="아직 방이 없습니다. 방 이름을 정하고 방 만들기를 누르세요." Foreground="{StaticResource Muted}" Margin="8"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Rooms}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="52" Margin="0,0,0,8" Padding="14,0,8,0" BorderThickness="1" BorderBrush="{StaticResource GoldDark}" Background="#99010A13">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Width="140" Height="34" Content="{Binding ButtonText}" Command="{Binding JoinCommand}" IsEnabled="{Binding CanJoin}" />
                                        <TextBlock Text="{Binding Text}" FontSize="17" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanJoin}" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <DockPanel Grid.Row="2">
            <Button DockPanel.Dock="Right" Content="방 만들기" Height="48" Width="220" Command="{Binding CreateCommand}" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="방 이름" Foreground="{StaticResource Gold}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox Text="{Binding RoomName, UpdateSourceTrigger=PropertyChanged}" Width="260" MaxLength="24" />
                <Button x:Name="HistoryButton" Content="지난 경기" Margin="20,0,0,0" Height="34" Command="{Binding History.OpenCommand}" />
                <Popup PlacementTarget="{Binding ElementName=HistoryButton}" IsOpen="{Binding History.IsOpen, Mode=TwoWay}" StaysOpen="False"
                       Placement="Top" AllowsTransparency="True" VerticalOffset="-6">
                    <Border Background="#EE010A13" BorderBrush="{StaticResource Gold}" BorderThickness="1" Padding="10" MaxHeight="360" Width="520">
                        <ListBox ItemsSource="{Binding History.Lines}" Background="Transparent" BorderThickness="0" />
                    </Border>
                </Popup>
                <TextBlock Text="{Binding Message}" Foreground="{StaticResource Red}" VerticalAlignment="Center" Margin="20,0,0,0" />
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
